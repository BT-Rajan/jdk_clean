DB_HOST=localhost
DB_PORT=3306
DB_USER=erp_user
DB_PASSWORD=
DB_NAME=jdk_clean

JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# http://localhost:5173 is `npm run dev`, :4173 is `npm run preview`
# (what install.sh's pm2 setup serves by default). Add your real domain
# here too for a production deployment.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional -- all default sensibly if omitted (see app/core/config.py).
# UPLOAD_DIR=uploads
# AVATAR_MAX_UPLOAD_MB=5
# AVATAR_MAX_DIMENSION=512

# Email (Phase 6) -- optional. Leave SMTP_HOST unset to leave email
# sending disabled; "Send email" on any document then returns a clear
# error instead of the app failing to start or half-working.
# Example values for Gmail (needs an App Password, not your normal
# password: https://support.google.com/accounts/answer/185833):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_FROM_EMAIL=you@gmail.com
#   SMTP_FROM_NAME=JDK Manufacturing
#   SMTP_USE_TLS=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=
# SMTP_USE_TLS=true
