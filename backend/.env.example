DB_HOST=localhost
DB_PORT=3306
DB_USER=erp_user
DB_PASSWORD=
DB_NAME=jdk_clean

JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# http://localhost:5173 is `npm run dev`, :4173 is `npm run preview`
# (what install.sh's pm2 setup serves by default). Add your real domain
# here too for a production deployment.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional -- all default sensibly if omitted (see app/core/config.py).
# UPLOAD_DIR=uploads
# AVATAR_MAX_UPLOAD_MB=5
# AVATAR_MAX_DIMENSION=512
