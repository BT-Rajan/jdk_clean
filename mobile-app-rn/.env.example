# Base URL of the jdk_clean FastAPI backend (no trailing slash). Same
# backend the web app's VITE_API_BASE_URL points at -- the EXPO_PUBLIC_
# prefix is Expo/Metro's equivalent of Vite's VITE_ prefix convention,
# inlined into the bundle (web and native alike) at build time.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
