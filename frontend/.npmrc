# npm's automatic vulnerability-advisory lookup (a POST to
# registry.npmjs.org's bulk security-advisories endpoint on every
# install/ci/update) measured out to 4+ minutes on its own in this
# environment, while every actual package resolved in 0ms from cache --
# see install.sh/relaunch.sh's comments on the frontend dependency step.
# It's a security scan npm bolts on by default, not part of installing
# anything. Disabling it here means it's off for ANY npm command run in
# this directory -- a hand-typed `npm install`, an editor's own npm
# call, a future script -- not just the two places that already pass
# --no-audit explicitly. Run `npm audit` yourself whenever you actually
# want that check; it still works standalone, this only stops it from
# running unasked on every install.
audit=false
fund=false
